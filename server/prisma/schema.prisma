
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResumeUploadStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETING
}
enum VerificationStatus {
  PENDING
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum GeneratedResumeStatus {
  DRAFT
  FINALIZED
}

enum ExtractionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  savedJobs SavedJob[]
  generatedResumes GeneratedResume[]
  candidateProfile CandidateProfile?

  resumes Resume[]
}

model Resume {
  id               String             @id @default(cuid())
  userId           String
  originalFilename String
  s3ObjectKey      String             @unique
  mimeType         String?
  sizeBytes        Int?
  checksumSha256   String?
  uploadStatus     ResumeUploadStatus @default(PENDING_UPLOAD)
  uploadExpiresAt  DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  extractions ResumeExtraction[]

  @@index([userId, uploadStatus])
  @@index([uploadExpiresAt])
}

model ResumeExtraction {
  id            String           @id @default(cuid())
  resumeId      String
  status        ExtractionStatus @default(QUEUED)
  parserVersion String
  result        Json?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())

  resume       Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  verification ResumeVerification?

  @@index([resumeId, createdAt])
  @@index([resumeId, status])
}
model ResumeVerification {
  id             String             @id @default(cuid())
  extractionId   String             @unique
  status         VerificationStatus @default(PENDING)
  checks         Json?
  failureReasons String[]           @default([])
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())

  extraction ResumeExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
}



enum JobProvider {
  GREENHOUSE
  HIMALAYAS
  LEVER
  AMAZON
}

enum JobStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum JobWorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum JobSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model JobSource {
  id           String      @id @default(cuid())
  provider     JobProvider
  companyName  String
  sourceKey    String
  boardToken   String?
  boardUrl     String?
  config       Json?
  countryCode  String      @default("IN")
  isActive     Boolean     @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  jobs     Job[]
  syncLogs JobSyncLog[]

  @@unique([provider, sourceKey])
@@index([isActive, provider])
  // @@index([isActive, provider])
}

model Job {
  id               String       @id @default(cuid())
  sourceId         String
  externalId       String
  title            String
  companyName      String
  location         String?
  countryCode      String?
  workMode         JobWorkMode  @default(UNKNOWN)
  employmentType   String?
  category         String?
  descriptionHtml  String?      @db.Text
  descriptionText  String?      @db.Text
  applyUrl         String
  sourcePostedAt   DateTime?
  sourceUpdatedAt  DateTime?
  firstSeenAt      DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  status           JobStatus    @default(ACTIVE)
  rawPayload       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  source    JobSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  savedBy   SavedJob[]
  generatedResumes GeneratedResume[]

  @@unique([sourceId, externalId])
  @@index([status, sourceUpdatedAt])
  @@index([countryCode, status])
  @@index([category, status])
  @@index([firstSeenAt])
}

model JobSyncLog {
  id            String        @id @default(cuid())
  sourceId      String
  status        JobSyncStatus @default(RUNNING)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  fetchedCount  Int           @default(0)
  createdCount  Int           @default(0)
  updatedCount  Int           @default(0)
  closedCount   Int           @default(0)
  errorMessage  String?       @db.Text

  source JobSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model CandidateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  profile        Json
  customizations Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model GeneratedResume {
  id        String                @id @default(cuid())
  userId    String
  jobId     String

  content   Json
  status    GeneratedResumeStatus @default(DRAFT)
  version   Int                   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, updatedAt])
  @@index([jobId])
}